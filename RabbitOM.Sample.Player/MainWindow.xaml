<Window x:Class="RabbitOM.Sample.Player.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RabbitOM.Sample.Player"
        xmlns:converters="clr-namespace:RabbitOM.Sample.Player.Converters"
        mc:Ignorable="d"
        Title="MEDIA Player SAMPLE - HEVC/H264/MJPEG"
		Height="650" 
		Width="750" 
		Loaded="OnWindowLoaded" 
		Closing="OnWindowClosing"
		Background="Azure" 
        FocusManager.FocusedElement="{Binding ElementName=ImageGrid}"
		>

    <Window.Resources>
        <converters:BooleanStretchValueConverter x:Key="BooleanStretchValueConverter" />
        <converters:BooleanVisibilityValueConverter x:Key="BooleanVisibilityValueConverter" />
    </Window.Resources>
    
    <Window.CommandBindings>

        <CommandBinding Command="{x:Static local:MainWindow.ControlCommand}" 
                        Executed="OnControl"
                        />
        
        <CommandBinding Command="{x:Static local:MainWindow.SaveImageCommand}" 
                        CanExecute="OnSaveImage"
                        Executed="OnSaveImage"
                        />

    </Window.CommandBindings>

    <Grid Margin="1,1,1,1" Background="White" >

        <TextBlock Margin="7,5,0,0"
                   HorizontalAlignment="Left" 
                   VerticalAlignment="Top" 
                   Width="65" 
                   TextAlignment="Left"
                   TextWrapping="Wrap" 
                   Text="RTSP URI :" 
                   />

        <ComboBox Margin="65,3,79,0" 
                  VerticalAlignment="Top" 
                  SelectedIndex="0" 
                  Height="22" 
                  IsEditable="True" 
                  Text="{Binding SelectedUri,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged, RelativeSource={RelativeSource AncestorType=Window}}"
                  ItemsSource="{Binding Uris,UpdateSourceTrigger=PropertyChanged, RelativeSource={RelativeSource AncestorType=Window}}"
                  />

        <Button Margin="0,3,2,0" 
                HorizontalAlignment="Right" 
                VerticalAlignment="Top" 
                Width="74" 
                Height="22"
                Content="{Binding ButtonStatus,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged, RelativeSource={RelativeSource AncestorType=Window}}"
                Command="{x:Static local:MainWindow.ControlCommand}" 
                />

        <Grid x:Name="ImageGrid"
              Margin="1,29,1,1" 
              Background="Black" 
              >

            <Grid.ContextMenu>

                <ContextMenu>

                    <MenuItem x:Name="menuItemStretch"
                              Header="Stretch"
                              IsCheckable="True"
                              />

                    <MenuItem x:Name="menuItemShowCodecInfo"
                              Header="Show Codec infos" 
                              IsCheckable="True"
                              IsChecked="True"
                              />

                    <Separator />

                    <MenuItem Header="Save Image" 
                              Command="{x:Static local:MainWindow.SaveImageCommand}" 
                              />

                </ContextMenu>

            </Grid.ContextMenu>

            <TextBlock VerticalAlignment="Center" 
                       HorizontalAlignment="Center" 
                       FontSize="20" 
                       Foreground="White" 
                       Text="{Binding StatusInfo,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged, RelativeSource={RelativeSource AncestorType=Window}}"
                       />

            <Image x:Name="_image"  
                   Margin="0,0,0,0" 
                   SnapsToDevicePixels="True" 
                   UseLayoutRounding="True" 
                   Source="{Binding Image,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged, RelativeSource={RelativeSource AncestorType=Window}}"
                   Stretch="{Binding ElementName=menuItemStretch, Path=IsChecked, Converter={StaticResource BooleanStretchValueConverter}}"
                   />

            <TextBlock VerticalAlignment="Bottom" 
                       HorizontalAlignment="Center" 
                       FontSize="15" 
                       Foreground="White" 
                       Background="Black"
                       Text="{Binding CodecInfo,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged, RelativeSource={RelativeSource AncestorType=Window}}"
                       Visibility="{Binding ElementName=menuItemShowCodecInfo, Path=IsChecked,Converter={StaticResource BooleanVisibilityValueConverter}}"
                       />

        </Grid>

    </Grid>

</Window>
