<UserControl x:Class="RabbitOM.Player.Controls.SpinningDiamond"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:RabbitOM.Player.Controls"
             mc:Ignorable="d" 
             Height="100" 
             Width="100"
             >
    <Grid>
        
        <Rectangle Width="60" 
                   Height="60" 
                   RenderTransformOrigin="0.5,0.5"
                   Fill="{Binding Fill, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" 
                   >
            
            <Rectangle.RenderTransform>
                <RotateTransform x:Name="DiamondRotate" Angle="45" />
            </Rectangle.RenderTransform>
            
        </Rectangle>
        
    </Grid>
    
</UserControl>
