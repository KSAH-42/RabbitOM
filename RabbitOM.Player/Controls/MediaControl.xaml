<UserControl x:Class="RabbitOM.Player.Controls.MediaControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:RabbitOM.Player.Controls"
             xmlns:converters="clr-namespace:RabbitOM.Player.Converters"
             mc:Ignorable="d" 
             Height="250" 
             Width="250"
             Background="Black"
             Loaded="OnLoaded"
             Unloaded="OnUnloaded"
             >
    
    <UserControl.Resources>
    
        <converters:BooleanStretchValueConverter x:Key="BooleanStretchValueConverter" />
        
        <converters:BooleanVisibilityValueConverter x:Key="BooleanVisibilityValueConverter" />
    
    </UserControl.Resources>
    
    <Grid>
    </Grid>
    
</UserControl>
