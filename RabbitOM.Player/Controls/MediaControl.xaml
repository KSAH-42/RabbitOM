<UserControl x:Class="RabbitOM.Player.Controls.MediaControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:RabbitOM.Player.Controls"
             xmlns:controls="clr-namespace:RabbitOM.Player.Controls"
             xmlns:converters="clr-namespace:RabbitOM.Player.Converters"
             mc:Ignorable="d" 
             Width="550"
             Height="450"
             Background="Black"
             Unloaded="OnUnloaded"
             FocusManager.FocusedElement="{Binding ElementName=_grid}"
             DataContext="{Binding RelativeSource={RelativeSource Mode=Self}}"
             >

    <UserControl.Resources>
        <converters:BooleanStretchValueConverter x:Key="BooleanStretchValueConverter" />
        <converters:BooleanVisibilityValueConverter x:Key="BooleanVisibilityValueConverter" />
    </UserControl.Resources>

    <Grid x:Name="_grid"
          x:FieldModifier="private"
          Grid.Row="1"
          Margin="1,0,1,1" 
          Background="Black">

        <controls:CommunicationStatusControl Fill="White"
                                             VerticalAlignment="Center" 
                                             HorizontalAlignment="Center" 
                                             Foreground="White"
                                             ConnectingMessage="Connecting..."
                                             ConnectingStatus="{Binding IsConnecting,UpdateSourceTrigger=PropertyChanged}"
                                             />

        <Image x:Name="_image"
               x:FieldModifier="private"
               Margin="0,0,0,0" 
               SnapsToDevicePixels="True" 
               UseLayoutRounding="True" 
               Focusable="True"
               Source="{Binding Image,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
               Stretch="{Binding StrechImage,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
               >
            <Image.RenderTransform>
                <TransformGroup>
                    <ScaleTransform ScaleX="{Binding ScaleX, ElementName=ZoomControl , UpdateSourceTrigger=PropertyChanged}" 
                                    ScaleY="{Binding ScaleY, ElementName=ZoomControl , UpdateSourceTrigger=PropertyChanged}" 
                                    />
                    <TranslateTransform X="{Binding TranslationX, ElementName=ZoomControl , UpdateSourceTrigger=PropertyChanged}" 
                                        Y="{Binding TranslationY, ElementName=ZoomControl , UpdateSourceTrigger=PropertyChanged}" 
                                        />
                </TransformGroup>
            </Image.RenderTransform>
        </Image>

        <StackPanel Orientation="Vertical" 
                    HorizontalAlignment="Center" 
                    VerticalAlignment="Bottom">

            <TextBlock FontSize="15" 
                       HorizontalAlignment="Center"
                       Foreground="White" 
                       Background="Black"
                       Text="{Binding Source,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
                       Visibility="{Binding SourceVisibility,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
                       />

        </StackPanel>

        <controls:NetworkStatisticsControl x:Name="_statistics" 
                                           x:FieldModifier="private"
                                           Margin="10,20,0,0" 
                                           HorizontalAlignment="Left"
                                           VerticalAlignment="Top"
                                           Visibility="Collapsed"
                                           />

        <controls:ZoomImageControl x:Name="ZoomControl"
                                   Margin="0,0,0,0" 
                                   HorizontalAlignment="Stretch"
                                   VerticalAlignment="Stretch"
                                   Focusable="False"
                                   TextColor="OrangeRed"
                                   Text="Zoom in"
                                   />

    </Grid>

</UserControl>
