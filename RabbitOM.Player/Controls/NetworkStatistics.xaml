<UserControl x:Class="RabbitOM.Player.Controls.NetworkStatistics"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:RabbitOM.Player.Controls"
             xmlns:converters="clr-namespace:RabbitOM.Player.Converters"
             mc:Ignorable="d" 
             Height="265" 
             Width="350"
             Loaded="OnUserControlLoaded"
             Unloaded="OnUserControlUnloaded"
             >

    <UserControl.Resources>

        <converters:BooleanStringValueConverter x:Key="BooleanStringValueConverter" TrueString="Connected" FalseString="Disconnected" />
        <converters:MemoryUnitValueConverter x:Key="MemoryUnitValueConverter" />
        <converters:HertzUnitValueConverter x:Key="HertzUnitValueConverter" />
        <converters:DoubleAdditionValueConverter x:Key="DoubleAdditionValueConverter" OffsetValue="0.1" />

    </UserControl.Resources>
    
    <Grid>
        
        <Border Background="#BF212124" 
                CornerRadius="8" 
                Width="Auto" 
                Height="auto" 
                >

            <Grid>

                <StackPanel Orientation="Vertical" >

                    <StackPanel Orientation="Horizontal">

                        <TextBlock Text="Connection status : " 
                                   FontSize="18" 
                                   Width="175" 
                                   TextAlignment="Right" 
                                   HorizontalAlignment="Left"
                                   Foreground="White" 
                                   />

                        <TextBlock Text="{Binding ConnectionStatus,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,Converter={StaticResource BooleanStringValueConverter},RelativeSource={RelativeSource AncestorType=UserControl}}"
                                   FontSize="18" 
                                   Foreground="Beige" 
                                   />
                        
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">

                        <TextBlock Text="Transport : " 
                                   FontSize="18" 
                                   Width="175" 
                                   TextAlignment="Right" 
                                   HorizontalAlignment="Left"
                                   Foreground="White" 
                                   />

                        <TextBlock Text="{Binding Transport,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,RelativeSource={RelativeSource AncestorType=UserControl}}"
                                   FontSize="18" 
                                   Foreground="Beige" 
                                   />

                    </StackPanel>

                    <StackPanel Orientation="Horizontal">

                        <TextBlock Text="Codec : " 
                                   FontSize="18" 
                                   Width="175" 
                                   TextAlignment="Right" 
                                   HorizontalAlignment="Left"
                                   Foreground="White" 
                                   />

                        <TextBlock Text="{Binding Codec,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,RelativeSource={RelativeSource AncestorType=UserControl}}"
                                   FontSize="18" 
                                   Foreground="Beige" 
                                   />

                    </StackPanel>

                    <StackPanel Orientation="Horizontal">

                        <TextBlock Text="Clock : " 
                                   FontSize="18" 
                                   Width="175" 
                                   TextAlignment="Right" 
                                   HorizontalAlignment="Left"
                                   Foreground="White" 
                                   />

                        <TextBlock Text="{Binding Clock,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,RelativeSource={RelativeSource AncestorType=UserControl},Converter={StaticResource HertzUnitValueConverter}}"
                                   FontSize="18" 
                                   Foreground="Beige" 
                                   />
                        
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">

                        <TextBlock Text="Width : " 
                                   FontSize="18" 
                                   Width="175" 
                                   TextAlignment="Right" 
                                   HorizontalAlignment="Left"
                                   Foreground="White" 
                                   />

                        <TextBlock Text="{Binding FrameWidth,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,RelativeSource={RelativeSource AncestorType=UserControl}}"
                                   FontSize="18" 
                                   Foreground="Beige" 
                                   />

                    </StackPanel>

                    <StackPanel Orientation="Horizontal">

                        <TextBlock Text="Height : " 
                                   FontSize="18" 
                                   Width="175" 
                                   TextAlignment="Right" 
                                   HorizontalAlignment="Left"
                                   Foreground="White" 
                                   />

                        <TextBlock Text="{Binding FrameHeight,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,RelativeSource={RelativeSource AncestorType=UserControl}}"
                                   FontSize="18" 
                                   Foreground="Beige" 
                                   />

                    </StackPanel>
                    <StackPanel Orientation="Horizontal">

                        <TextBlock  Text="Frame rate : " 
                                    FontSize="18" 
                                    Width="175" 
                                    TextAlignment="Right" 
                                    HorizontalAlignment="Left"
                                    Foreground="White" 
                                    />

                        <TextBlock Text="{Binding FrameCountPerSecond,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,RelativeSource={RelativeSource AncestorType=UserControl}}"
                                   FontSize="18" 
                                   Foreground="Beige" 
                                   />

                        <TextBlock Text=" / sec" 
                                   FontSize="18" 
                                   Foreground="Beige" 
                                   />

                    </StackPanel>

                    <StackPanel Orientation="Horizontal">

                        <ProgressBar Orientation="Horizontal"
                                     Margin="175,0,0,0"
                                     Height="7"
                                     Width="125"
                                     Minimum="0"
                                     Maximum="{Binding MaxFrameCountPerSecond,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged, RelativeSource={RelativeSource AncestorType=UserControl},Converter={StaticResource DoubleAdditionValueConverter}}"
                                     Value="{Binding FrameCountPerSecond,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                     Background="Transparent"
                                     />

                    </StackPanel>

                    <StackPanel Orientation="Horizontal">

                        <TextBlock Text="Bandwidth : " 
                                   FontSize="18" 
                                   Width="175" 
                                   TextAlignment="Right" 
                                   HorizontalAlignment="Left"
                                   Foreground="White" 
                                   />

                        <TextBlock Text="{Binding BytesReceivedPerSecond,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,Converter={StaticResource MemoryUnitValueConverter}, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                   FontSize="18" 
                                   Foreground="Beige" 
                                   />
                        
                        <TextBlock Text=" / sec" 
                                   FontSize="18" 
                                   Foreground="Beige" 
                                   />
                        
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">

                        <ProgressBar Orientation="Horizontal"
                                     Margin="175,0,0,0"
                                     Height="7"
                                     Width="125"
                                     Minimum="0"
                                     Maximum="{Binding MaxBytesReceivedPerSecond,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged, RelativeSource={RelativeSource AncestorType=UserControl},Converter={StaticResource DoubleAdditionValueConverter}}"
                                     Value="{Binding BytesReceivedPerSecond,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                     Background="Transparent"
                                     />

                    </StackPanel>

                    <StackPanel Orientation="Horizontal">

                        <TextBlock Text="Packet received : " 
                                   FontSize="18" 
                                   Width="175" 
                                   TextAlignment="Right" 
                                   HorizontalAlignment="Left"
                                   Foreground="White" 
                                   />

                        <TextBlock Text="{Binding PacketReceivedPerSecond,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                   FontSize="18" 
                                   Foreground="Beige" 
                                   />

                        <TextBlock Text=" / sec" 
                                   FontSize="18" 
                                   Foreground="Beige" 
                                   />

                    </StackPanel>

                    <StackPanel Orientation="Horizontal">

                        <ProgressBar Orientation="Horizontal"
                                     Margin="175,0,0,0"
                                     Height="7"
                                     Width="125"
                                     Minimum="0"
                                     Maximum="{Binding MaxPacketReceivedPerSecond,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged, RelativeSource={RelativeSource AncestorType=UserControl},Converter={StaticResource DoubleAdditionValueConverter}}"
                                     Value="{Binding PacketReceivedPerSecond,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                     Background="Transparent"
                                     />

                    </StackPanel>
                    <StackPanel Orientation="Horizontal">

                        <TextBlock Text="Packets lost : " 
                                   FontSize="18" 
                                   Width="175" 
                                   TextAlignment="Right" 
                                   HorizontalAlignment="Left"
                                   Foreground="White" 
                                   />

                        <TextBlock Text="{Binding PacketsLostCount,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                   FontSize="18" 
                                   Foreground="Beige" 
                                   />

                    </StackPanel>

                </StackPanel>

            </Grid>

        </Border>
        
    </Grid>
    
</UserControl>
