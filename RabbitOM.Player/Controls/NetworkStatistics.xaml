<UserControl x:Class="RabbitOM.Player.Controls.NetworkStatistics"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:RabbitOM.Player.Controls"
             xmlns:converters="clr-namespace:RabbitOM.Player.Converters"
             mc:Ignorable="d" 
             Height="279" 
             Width="365"
             Loaded="OnUserControlLoaded"
             Unloaded="OnUserControlUnloaded"
             DataContext="{Binding RelativeSource={RelativeSource Mode=Self}}"
             >

    <UserControl.Resources>

        <converters:BooleanStringValueConverter x:Key="BooleanStringValueConverter" TrueString="Connected" FalseString="Disconnected" />
        <converters:MemoryUnitValueConverter x:Key="MemoryUnitValueConverter" />
        <converters:HertzUnitValueConverter x:Key="HertzUnitValueConverter" />
        <converters:AddDoubleValueConverter x:Key="AddDoubleValueConverter" OffsetValue="0.1" />

    </UserControl.Resources>
    
    <Grid>
        
        <Border Background="#BF212124" 
                CornerRadius="8" 
                Width="Auto" 
                Height="auto" 
                >

            <Grid>

                <StackPanel Orientation="Vertical" >

                    <StackPanel Orientation="Horizontal">

                        <TextBlock Text="Connection status : " 
                                   FontSize="18" 
                                   Width="175" 
                                   TextAlignment="Right" 
                                   HorizontalAlignment="Left"
                                   Foreground="White" 
                                   />

                        <TextBlock Text="{Binding ConnectionStatus,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,Converter={StaticResource BooleanStringValueConverter}}"
                                   FontSize="18" 
                                   Foreground="Beige" 
                                   />
                        
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">

                        <TextBlock Text="Transport : " 
                                   FontSize="18" 
                                   Width="175" 
                                   TextAlignment="Right" 
                                   HorizontalAlignment="Left"
                                   Foreground="White" 
                                   />

                        <TextBlock Text="{Binding Transport,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
                                   FontSize="18" 
                                   Foreground="Beige" 
                                   />

                    </StackPanel>

                    <StackPanel Orientation="Horizontal">

                        <TextBlock Text="Codec : " 
                                   FontSize="18" 
                                   Width="175" 
                                   TextAlignment="Right" 
                                   HorizontalAlignment="Left"
                                   Foreground="White" 
                                   />

                        <TextBlock Text="{Binding Codec,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
                                   FontSize="18" 
                                   Foreground="Beige" 
                                   />

                    </StackPanel>

                    <StackPanel Orientation="Horizontal">

                        <TextBlock Text="Clock : " 
                                   FontSize="18" 
                                   Width="175" 
                                   TextAlignment="Right" 
                                   HorizontalAlignment="Left"
                                   Foreground="White" 
                                   />

                        <TextBlock Text="{Binding Clock,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,Converter={StaticResource HertzUnitValueConverter}}"
                                   FontSize="18" 
                                   Foreground="Beige" 
                                   />
                        
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">

                        <TextBlock Text="Width : " 
                                   FontSize="18" 
                                   Width="175" 
                                   TextAlignment="Right" 
                                   HorizontalAlignment="Left"
                                   Foreground="White" 
                                   />

                        <TextBlock Text="{Binding FrameWidth,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
                                   FontSize="18" 
                                   Foreground="Beige" 
                                   />

                    </StackPanel>

                    <StackPanel Orientation="Horizontal">

                        <TextBlock Text="Height : " 
                                   FontSize="18" 
                                   Width="175" 
                                   TextAlignment="Right" 
                                   HorizontalAlignment="Left"
                                   Foreground="White" 
                                   />

                        <TextBlock Text="{Binding FrameHeight,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
                                   FontSize="18" 
                                   Foreground="Beige" 
                                   />

                    </StackPanel>
                    <StackPanel Orientation="Horizontal">

                        <TextBlock  Text="Framerate : " 
                                    FontSize="18" 
                                    Width="175" 
                                    TextAlignment="Right" 
                                    HorizontalAlignment="Left"
                                    Foreground="White" 
                                    />

                        <TextBlock Text="{Binding FrameCountPerSecond,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
                                   FontSize="18" 
                                   Foreground="Beige" 
                                   />

                        <TextBlock Text=" / sec" 
                                   FontSize="18" 
                                   Foreground="Beige" 
                                   />

                    </StackPanel>

                    <StackPanel Orientation="Horizontal">

                        <StackPanel Orientation="Horizontal"
                                    Margin="175,0,0,0"
                                    >
                            <ProgressBar Orientation="Horizontal"
                                         Height="8"
                                         Width="125"
                                         Minimum="0"
                                         Maximum="{Binding MaxFrameCountPerSecond,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,Converter={StaticResource AddDoubleValueConverter}}"
                                         Value="{Binding FrameCountPerSecond,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
                                         Background="Transparent"
                                         />

                            <TextBlock Margin="3,0,0,0"
                                       Text="{Binding MaxFrameCountPerSecond,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
                                       FontSize="9" 
                                       Foreground="Beige" 
                                       />

                            <TextBlock Text=" fps"
                                       FontSize="9" 
                                       Foreground="Beige" 
                                       />
                            
                        </StackPanel>

                    </StackPanel>

                    <StackPanel Orientation="Horizontal">

                        <TextBlock Text="Bitrate : " 
                                   FontSize="18" 
                                   Width="175" 
                                   TextAlignment="Right" 
                                   HorizontalAlignment="Left"
                                   Foreground="White" 
                                   />

                        <TextBlock Text="{Binding BytesReceivedPerSecond,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,Converter={StaticResource MemoryUnitValueConverter}}"
                                   FontSize="18" 
                                   Foreground="Beige" 
                                   />
                        
                        <TextBlock Text=" / sec" 
                                   FontSize="18" 
                                   Foreground="Beige" 
                                   />
                        
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">

                        <StackPanel Orientation="Horizontal"
                                    Margin="175,0,0,0"
                                    >
                        
                            <ProgressBar Orientation="Horizontal"
                                         Height="8"
                                         Width="125"
                                         Minimum="0"
                                         Maximum="{Binding MaxBytesReceivedPerSecond,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged, Converter={StaticResource AddDoubleValueConverter}}"
                                         Value="{Binding BytesReceivedPerSecond,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
                                         Background="Transparent"
                                         />
           
                            <TextBlock Margin="3,0,0,0"
                                       Text="{Binding MaxBytesReceivedPerSecond,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged, Converter={StaticResource MemoryUnitValueConverter}}"
                                       FontSize="9" 
                                       Foreground="Beige" 
                                       />
                            
                        </StackPanel>

                    </StackPanel>

                    <StackPanel Orientation="Horizontal">

                        <TextBlock Text="Packets received : " 
                                   FontSize="18" 
                                   Width="175" 
                                   TextAlignment="Right" 
                                   HorizontalAlignment="Left"
                                   Foreground="White" 
                                   />

                        <TextBlock Text="{Binding PacketReceivedPerSecond,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
                                   FontSize="18" 
                                   Foreground="Beige" 
                                   />

                        <TextBlock Text=" / sec" 
                                   FontSize="18" 
                                   Foreground="Beige" 
                                   />

                    </StackPanel>

                    <StackPanel Orientation="Horizontal">

                        <StackPanel Orientation="Horizontal"
                                    Margin="175,0,0,0"
                                    >
                            
                            <ProgressBar Orientation="Horizontal"
                                         Height="8"
                                         Width="125"
                                         Minimum="0"
                                         Maximum="{Binding MaxPacketReceivedPerSecond,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged, Converter={StaticResource AddDoubleValueConverter}}"
                                         Value="{Binding PacketReceivedPerSecond,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
                                         Background="Transparent"
                                         />

                            <TextBlock Margin="3,0,0,0"
                                       Text="{Binding MaxPacketReceivedPerSecond,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
                                       FontSize="9" 
                                       Foreground="Beige" 
                                       />

                            <TextBlock Text=" pps"
                                       FontSize="9" 
                                       Foreground="Beige" 
                                       />

                        </StackPanel>
                        

                    </StackPanel>
                    
                    <StackPanel Orientation="Horizontal">

                        <TextBlock Text="Packets lost : " 
                                   FontSize="18" 
                                   Width="175" 
                                   TextAlignment="Right" 
                                   HorizontalAlignment="Left"
                                   Foreground="White" 
                                   />

                        <TextBlock Text="{Binding PacketsLostCount,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
                                   FontSize="18" 
                                   Foreground="Beige" 
                                   />

                    </StackPanel>

                </StackPanel>

            </Grid>

        </Border>
        
    </Grid>
    
</UserControl>
