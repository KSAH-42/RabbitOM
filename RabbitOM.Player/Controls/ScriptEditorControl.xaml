<UserControl x:Class="RabbitOM.Player.Controls.ScriptEditorControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:RabbitOM.Player.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="450" 
			 d:DesignWidth="800"
			 DataContext="{Binding RelativeSource={RelativeSource Mode=Self}}"
			 >
	<Grid>
		
		<TextBox Margin="1,1,1,50" 
				 AcceptsReturn="True" 
				 AcceptsTab="True" 
				 HorizontalAlignment="Stretch" 
				 HorizontalScrollBarVisibility="Auto"
				 VerticalAlignment="Stretch" 
				 VerticalScrollBarVisibility="Auto"
				 Text="{Binding Script,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
				 />

		<TextBlock Text="Not available" 
				   Foreground="Yellow" 
				   HorizontalAlignment="Center" 
				   VerticalAlignment="Center" 
				   />
		
	</Grid>
	
</UserControl>
