<UserControl x:Class="RabbitOM.Player.Controls.ScriptEditorControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:RabbitOM.Player.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="450" 
			 d:DesignWidth="800"
			 >
	<Grid>
		
		<TextBox Margin="1,1,1,50" 
				 AcceptsReturn="True" 
				 AcceptsTab="True" 
				 HorizontalAlignment="Stretch" 
				 HorizontalScrollBarVisibility="Auto"
				 VerticalAlignment="Stretch" 
				 VerticalScrollBarVisibility="Auto"
				 Text="{Binding Script,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
				 />

		<StackPanel HorizontalAlignment="Left" 
					VerticalAlignment="Bottom"
					Orientation="Horizontal"
					Margin="0,0,0,10"
					>

			<Button Content="Import"
					Width="100"
					Margin="5,0,0,0"
					/>

			<Button Content="Export"
					HorizontalAlignment="Left" 
					VerticalAlignment="Bottom"
					Width="100"
					Margin="7,0,0,0"
					/>
			
		</StackPanel>

		<StackPanel HorizontalAlignment="Right" 
					VerticalAlignment="Bottom"
					Orientation="Horizontal"
					Margin="0,0,0,10"
					>

			<Button Content="Run"
					Width="100"
					Margin="0,0,5,0"
					/>

		</StackPanel>
		

		<TextBlock Text="Not available" 
				   Foreground="Yellow" 
				   HorizontalAlignment="Center" 
				   VerticalAlignment="Center" 
				   />
		
	</Grid>
	
</UserControl>
