<UserControl x:Class="RabbitOM.Player.Controls.ViewPortControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:RabbitOM.Player.Controls"
             mc:Ignorable="d"
			 DataContext="{Binding RelativeSource={RelativeSource Mode=Self}}"
			 IsEnabledChanged="OnControlEnabledChanged"
             >

	<UserControl.Resources>
		<Storyboard x:Key="ZoomStoryboard">

			<DoubleAnimation Storyboard.TargetName="ImageScale"
							 Storyboard.TargetProperty="ScaleX"
							 Duration="0:0:0.1"
							 />

			<DoubleAnimation Storyboard.TargetName="ImageScale"
							 Storyboard.TargetProperty="ScaleY"
							 Duration="0:0:0.1"
							 />

			<DoubleAnimation Storyboard.TargetName="ImageTranslate"
							 Storyboard.TargetProperty="X"
							 Duration="0:0:0.1"
							 />

			<DoubleAnimation Storyboard.TargetName="ImageTranslate" 
							 Storyboard.TargetProperty="Y"
							 Duration="0:0:0.1"
							 />
		</Storyboard>
		
	</UserControl.Resources>
	

	<Grid ClipToBounds="True">

		<Image x:Name="_image"
                x:FieldModifier="private"
                Margin="0,0,0,0" 
                SnapsToDevicePixels="True" 
                UseLayoutRounding="True" 
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Stretch="{Binding StretchImage,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,RelativeSource={RelativeSource AncestorType=UserControl}}"
                >
			<Image.RenderTransform>
				<TransformGroup>
					<ScaleTransform x:Name="ImageScale" />
					<TranslateTransform x:Name="ImageTranslate" />
				</TransformGroup>
			</Image.RenderTransform>
		</Image>

		<Canvas Margin="0"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Background="Transparent"
                IsHitTestVisible="True"
				MouseLeftButtonDown="OnCanvasMouseLeftButtonDown"
                MouseUp="OnCanvasMouseUp"
                MouseMove="OnCanvasMouseMove"
                >
			
			<Rectangle x:Name="OuterRectangle"
                       Margin="0"
                       HorizontalAlignment="Stretch"
                       VerticalAlignment="Stretch"
                       Stroke="WhiteSmoke" 
                       StrokeThickness="1.5"
                       StrokeDashArray="2 2"
                       Canvas.Left="{Binding ZoomProperties.SelectionX}"
                       Canvas.Top="{Binding ZoomProperties.SelectionY}"
                       Width="{Binding ZoomProperties.SelectionWidth}"
                       Height="{Binding ZoomProperties.SelectionHeight}"
                       Visibility="{Binding ZoomProperties.Visibility,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
                       />

			<Rectangle x:Name="InnerRectangle"
                       Margin="0"
                       HorizontalAlignment="Stretch"
                       VerticalAlignment="Stretch"
                       Stroke="GreenYellow" 
                       StrokeThickness="2.0" 
                       Fill="#30AAA0A0" 
                       Visibility="{Binding ZoomProperties.Visibility,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
                       />

			<TextBlock x:Name="TextInfos"
                       Text="{Binding ZoomProperties.Text,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" 
                       Foreground="{Binding ZoomProperties.TextColor,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Canvas.Left="{Binding ZoomProperties.TextPositionX,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
                       Canvas.Top="{Binding ZoomProperties.TextPositionY,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
                       Visibility="{Binding ZoomProperties.Visibility,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
                       />

		</Canvas>

	</Grid>

</UserControl>
