<UserControl x:Class="RabbitOM.Player.Controls.MediaPlayer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:RabbitOM.Player.Controls"
             xmlns:controls="clr-namespace:RabbitOM.Player.Controls"
             xmlns:converters="clr-namespace:RabbitOM.Player.Converters"
             mc:Ignorable="d" 
             d:DesignWidth="550"
             d:DesignHeight="450"
             Unloaded="OnUnloaded"
             >

    <UserControl.Resources>
        <ResourceDictionary>
            <converters:BooleanStretchValueConverter x:Key="BooleanStretchValueConverter" />
            <converters:BooleanVisibilityValueConverter x:Key="BooleanVisibilityValueConverter" />
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Grid.Row="1"
          Margin="1,21,1,-20" 
          Background="Black"
          >

        <controls:CommunicationStatusControl Fill="White"
                                             VerticalAlignment="Top" 
                                             HorizontalAlignment="Center" 
                                             Foreground="White"
                                             ConnectingMessage="Connecting..."
                                             ConnectingStatus="{Binding IsConnecting,UpdateSourceTrigger=PropertyChanged,RelativeSource={RelativeSource AncestorType=UserControl}}" Margin="0,246,0,0"
                                             />

        <Image x:Name="_image"
               x:FieldModifier="private"
               Margin="0,0,0,0" 
               SnapsToDevicePixels="True" 
               UseLayoutRounding="True" 
               HorizontalAlignment="Stretch"
               VerticalAlignment="Stretch"
               Stretch="{Binding StretchImage,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,RelativeSource={RelativeSource AncestorType=UserControl}}"
               >
            <Image.RenderTransform>
                <TransformGroup>
                    <ScaleTransform ScaleX="{Binding ScaleX, ElementName=ZoomControl , UpdateSourceTrigger=PropertyChanged}" 
                                    ScaleY="{Binding ScaleY, ElementName=ZoomControl , UpdateSourceTrigger=PropertyChanged}" 
                                    />
                    <TranslateTransform X="{Binding TranslationX, ElementName=ZoomControl , UpdateSourceTrigger=PropertyChanged}" 
                                        Y="{Binding TranslationY, ElementName=ZoomControl , UpdateSourceTrigger=PropertyChanged}" 
                                        />
                </TransformGroup>
            </Image.RenderTransform>
        </Image>

        <TextBlock FontSize="15" 
                   HorizontalAlignment="Center"
                   Foreground="White" 
                   Background="Black"
                   VerticalAlignment="Bottom"
                   Text="{Binding Source,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,RelativeSource={RelativeSource AncestorType=UserControl}}"
                   Visibility="{Binding SourceVisibility,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,RelativeSource={RelativeSource AncestorType=UserControl}}"
                   />

        <controls:NetworkStatisticsControl x:Name="_statistics" 
                                           x:FieldModifier="private"
                                           Margin="10,20,0,0" 
                                           HorizontalAlignment="Left"
                                           VerticalAlignment="Top"
                                           Visibility="{Binding StatisticsVisibility,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,RelativeSource={RelativeSource AncestorType=UserControl}}"
                                           />

        <controls:ZoomImageControl x:Name="ZoomControl"
                                   Margin="0,0,0,0" 
                                   HorizontalAlignment="Stretch"
                                   VerticalAlignment="Stretch"
                                   Focusable="False"
                                   TextColor="OrangeRed"
                                   Text="Zoom in"
                                   />

    </Grid>

</UserControl>
