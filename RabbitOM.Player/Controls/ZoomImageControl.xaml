<UserControl x:Class="RabbitOM.Player.Controls.ZoomImageControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:RabbitOM.Player.Controls"
             mc:Ignorable="d" 
             DataContext="{Binding RelativeSource={RelativeSource Mode=Self}}"
             IsEnabledChanged="OnControlEnabledChanged"
             >
    <Grid>
        
        <Canvas Margin="0"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Background="Transparent"
                IsHitTestVisible="True"
                MouseLeftButtonDown="OnCanvasMouseLeftButtonDown"
                MouseUp="OnCanvasMouseUp"
                MouseMove="OnCanvasMouseMove"
                >

        <Rectangle x:Name="OuterRectangle"
                   Margin="0"
                   HorizontalAlignment="Stretch"
                   VerticalAlignment="Stretch"
                   Stroke="WhiteSmoke" 
                   StrokeThickness="1.5"
                   StrokeDashArray="2 2"
                   Canvas.Left="{Binding SelectionX}"
                   Canvas.Top="{Binding SelectionY}"
                   Width="{Binding SelectionWidth}"
                   Height="{Binding SelectionHeight}"
                   Visibility="{Binding RegionVisibility,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
                   />

        <Rectangle x:Name="InnerRectangle"
                   Margin="0"
                   HorizontalAlignment="Stretch"
                   VerticalAlignment="Stretch"
                   Stroke="White" 
                   StrokeThickness="2.0" 
                   Fill="#30AAA0A0" 
                   Visibility="{Binding RegionVisibility,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
                   />

            <TextBlock x:Name="TextInfos"
                       Text="{Binding Text,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" 
                       Foreground="{Binding TextColor,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Canvas.Left="{Binding TextPositionX,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
                       Canvas.Top="{Binding TextPositionY,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
                       Visibility="{Binding RegionVisibility,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
                       />
            
        </Canvas>
        
    </Grid>
    
</UserControl>
