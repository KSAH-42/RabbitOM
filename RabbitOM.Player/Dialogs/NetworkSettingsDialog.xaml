<Window x:Class="RabbitOM.Player.Dialogs.NetworkSettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RabbitOM.Player.Dialogs"
        xmlns:converters="clr-namespace:RabbitOM.Player.Converters"
        xmlns:validation="clr-namespace:RabbitOM.Player.Validation"
        mc:Ignorable="d"
        Title="NETWORK SETTINGS" 
        Height="257"
        Width="330"
        MinWidth="330"
        MinHeight="257"
        WindowStartupLocation="CenterOwner"
        Style="{DynamicResource WindowStyle}"
        ShowInTaskbar="False"
        >

    <Window.Resources>

        <converters:StringVisibilityValueConverter x:Key="UdpStringVisibilityValueConverter" 
                                                   Text="{x:Static local:NetworkSettingsDialog.UdpTransport}"
                                                   />

        <converters:StringVisibilityValueConverter x:Key="MulticastStringVisibilityValueConverter" 
                                                   Text="{x:Static local:NetworkSettingsDialog.MulticastTransport}"
                                                   />

        <converters:BooleanVisibilityValueConverter x:Key="BooleanVisibilityValueConverter" />
        
        <converters:BooleanMultiValueConverter x:Key="BooleanMultiValueConverter" />

    </Window.Resources>

    <Window.CommandBindings>

        <CommandBinding Command="{x:Static local:NetworkSettingsDialog.CloseCommand}" 
                        Executed="OnClose" 
                        />

    </Window.CommandBindings>


    <Grid Background="#FF121212" >

        <Grid.RowDefinitions>

            <RowDefinition Height="35" />
            <RowDefinition MinHeight="100" Height="*" />
            <RowDefinition Height="20" />
            <RowDefinition Height="50" />

        </Grid.RowDefinitions>

        <Grid Grid.Row="0">

            <TextBlock Text="Please restart the communication after the changes"
                       Foreground="White"
                       FontSize="10"
                       HorizontalAlignment="Stretch"
                       VerticalAlignment="Center"
                       />

        </Grid>

        <Grid Grid.Row="1">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" >

                    <TextBlock Text="Transport :"
                               Foreground="White"
                               HorizontalAlignment="Right"
                               Margin="0,0,0,0"
                               />

                    <TextBlock Text="Port :"
                               Foreground="White"
                               HorizontalAlignment="Right"
                               Margin="0,39,0,0"
                               Visibility="{Binding IsDatagramProtocol,Converter={StaticResource BooleanVisibilityValueConverter},RelativeSource={RelativeSource AncestorType=Window}}"
                               />
                    
                    <TextBlock Text="IP Address :"
                               Foreground="White"
                               HorizontalAlignment="Right"
                               Margin="0,75,0,0"
                               Visibility="{Binding SelectedTransport,Converter={StaticResource MulticastStringVisibilityValueConverter},RelativeSource={RelativeSource AncestorType=Window}}"
                               />

                </Grid>

                <Grid Grid.Column="1" Margin="10,0,0,0">

                    <ComboBox  Foreground="White"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Top"
                               IsEditable="False"
                               IsReadOnly="True"
                               Background="Black"
                               Width="200"
                               Margin="0,-1,0,0"
                               SelectedIndex="0"
                               SelectedItem="{Binding SelectedTransport,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,RelativeSource={RelativeSource AncestorType=Window}}"
                               ItemsSource="{Binding Transports,RelativeSource={RelativeSource AncestorType=Window}}"
                               />

                    <TextBox   x:Name="_port1"
                               Width="200"
                               Margin="0,37,0,0"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Top"
                               Height="27"
                               Visibility="{Binding IsDatagramProtocol,Converter={StaticResource BooleanVisibilityValueConverter},RelativeSource={RelativeSource AncestorType=Window}}"
                               >
                        <TextBox.Text>

                            <Binding Path="Port"
                                     Mode="TwoWay" 
                                     UpdateSourceTrigger="PropertyChanged" 
                                     RelativeSource="{RelativeSource AncestorType=Window}"
                                     >

                                <Binding.ValidationRules>
                                    <validation:PortValidationRule/>
                                </Binding.ValidationRules>

                            </Binding>

                        </TextBox.Text>

                    </TextBox>

                    <TextBox   x:Name="_ipAddress"
                               Width="200"
                               Margin="0,75,0,0"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Top"
                               Height="27"
                               Visibility="{Binding SelectedTransport,Converter={StaticResource MulticastStringVisibilityValueConverter},RelativeSource={RelativeSource AncestorType=Window}}"
                               >
                        <TextBox.Text>

                            <Binding Path="IPAddress"
                                     Mode="TwoWay" 
                                     UpdateSourceTrigger="PropertyChanged" 
                                     RelativeSource="{RelativeSource AncestorType=Window}"
                                     >

                                <Binding.ValidationRules>
                                    <validation:MulticastIPAddressValidationRule/>
                                </Binding.ValidationRules>

                            </Binding>

                        </TextBox.Text>

                    </TextBox>

                </Grid>

            </Grid>

        </Grid>

        <Grid Grid.Row="2">

            <TextBlock Text="Make sure that the port is not blocked by anything, otherwise use TCP"
                       Foreground="White"
                       FontSize="10"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Top"
                       Visibility="{Binding IsDatagramProtocol,Converter={StaticResource BooleanVisibilityValueConverter},RelativeSource={RelativeSource AncestorType=Window}}"
                       />

        </Grid>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="46*"/>
                <ColumnDefinition Width="10*"/>
                <ColumnDefinition Width="105*"/>
            </Grid.ColumnDefinitions>

            <Button Content="Cancel"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Width="80"
                    Margin="28,0,0,0"
                    IsCancel="True" Grid.Column="2"
                    />

            <Button Content="Ok"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Width="80"
                    Margin="120,0,0,0"
                    IsDefault="True"
                    Command="{x:Static local:NetworkSettingsDialog.CloseCommand}" Grid.Column="2"
                    >

                <Button.IsEnabled>

                    <MultiBinding Converter="{StaticResource BooleanMultiValueConverter}">
                        <Binding ElementName="_port1" Path="(Validation.HasError)" />
                        <Binding ElementName="_ipAddress" Path="(Validation.HasError)" />
                    </MultiBinding>

                </Button.IsEnabled>

            </Button>

        </Grid>

    </Grid>

</Window>
