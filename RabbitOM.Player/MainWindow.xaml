<Window x:Class="RabbitOM.Player.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RabbitOM.Player"
        xmlns:controls="clr-namespace:RabbitOM.Player.Controls"
        xmlns:converters="clr-namespace:RabbitOM.Player.Converters"
        mc:Ignorable="d"
        Title="MEDIA PLAYER - HEVC/H264/MJPEG"
		Height="725" 
		Width="890"
        MinHeight="420"
        MinWidth="420"
		Closing="OnWindowClosing"
		Style="{DynamicResource WindowStyle}"
        Icon="pack://application:,,,/Resources/icon.ico"
        WindowState="Maximized"
		>

	<Window.Resources>
		<converters:BooleanStretchValueConverter x:Key="BooleanStretchValueConverter" />
		<converters:BooleanVisibilityValueConverter x:Key="BooleanVisibilityValueConverter" />
		<converters:RevertBooleanVisibilityValueConverter x:Key="RevertBooleanVisibilityValueConverter"   />
		<converters:VisibilityBooleanValueConverter x:Key="VisibilityBooleanValueConverter" />
	</Window.Resources>

	<Window.InputBindings>

		<KeyBinding Key="F11" Command="{Binding ToggleFullScreenCommand,RelativeSource={RelativeSource AncestorType=Window}}" />
		<KeyBinding Key="F6"  Command="{Binding FocusCommand,RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding ElementName=UriSources}" />

	</Window.InputBindings>


	<DockPanel>

		<Menu DockPanel.Dock="Top">

			<MenuItem Header="Application">
				<MenuItem Header="Quit" Command="{x:Static ApplicationCommands.Close}" />
			</MenuItem>

			<MenuItem Header="Configuration">
				<MenuItem Header="Network settings" Command="{Binding ShowNetworkSettingsDialogCommand,RelativeSource={RelativeSource AncestorType=Window}}" />
			</MenuItem>

			<MenuItem Header="Views">
				
				<MenuItem Header="Full screen" 
						  Command="{Binding ToggleFullScreenCommand,RelativeSource={RelativeSource AncestorType=Window}}" InputGestureText="F11" 
						  />
				
				<Separator/>

				<MenuItem Header="Stretch" 
						  Command="{Binding ToggleStretchCommand,RelativeSource={RelativeSource AncestorType=Window}}" 
						  IsCheckable="True"
						  IsChecked="{Binding StretchImage,Mode=OneWay,UpdateSourceTrigger=PropertyChanged,Converter={StaticResource BooleanStretchValueConverter},RelativeSource={RelativeSource AncestorType=Window}}"
						  />

				<MenuItem Header="Show infos" 
						  Command="{Binding ShowInfoCommand,RelativeSource={RelativeSource AncestorType=Window}}" 
						  IsCheckable="True"
						  IsChecked="{Binding InfoVisibility,Mode=OneWay,UpdateSourceTrigger=PropertyChanged,Converter={StaticResource VisibilityBooleanValueConverter},RelativeSource={RelativeSource AncestorType=Window}}"
						  />

				<MenuItem Header="Show statistics" 
						  Command="{Binding ShowStatisticsCommand,RelativeSource={RelativeSource AncestorType=Window}}" 
						  IsCheckable="True"
						  IsChecked="{Binding StatisticsVisibility,Mode=OneWay,UpdateSourceTrigger=PropertyChanged,Converter={StaticResource VisibilityBooleanValueConverter},RelativeSource={RelativeSource AncestorType=Window}}"
						  />

				<MenuItem Header="Save Image" 
						  Command="{Binding SaveImageCommand,RelativeSource={RelativeSource AncestorType=Window}}" 
						  />
				
			</MenuItem>

			<MenuItem Header="Help">
				<MenuItem Header="About" 
						  Command="{Binding ShowAboutDialogCommand,RelativeSource={RelativeSource AncestorType=Window}}" 
						  />
			</MenuItem>

		</Menu>

		<Grid Margin="1,1,1,1" >

			<Grid.RowDefinitions>
				<RowDefinition Height="39" />
				<RowDefinition Height="*" />
			</Grid.RowDefinitions>

			<Grid Grid.Row="0" Margin="0,2,0,0" >

				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="82" />
					<ColumnDefinition Width="*" />
					<ColumnDefinition Width="39" />
					<ColumnDefinition Width="102" />
				</Grid.ColumnDefinitions>

				<Grid Grid.Column="0">

					<TextBlock Margin="10,5,1,1"
                               HorizontalAlignment="Left" 
                               VerticalAlignment="Top" 
                               Foreground="White"
                               TextAlignment="Right"
                               Text="RTSP URI :" 
                               />

				</Grid>

				<Grid Grid.Column="1">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="313*"/>
						<ColumnDefinition Width="344*"/>
					</Grid.ColumnDefinitions>

					<ComboBox x:Name="UriSources"
                              VerticalAlignment="Top" 
                              SelectedIndex="0" 
                              Height="29" 
                              IsEditable="True" 
                              Text="{Binding SelectedSource,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,RelativeSource={RelativeSource AncestorType=Window}}"
                              ItemsSource="{Binding Sources,UpdateSourceTrigger=PropertyChanged,RelativeSource={RelativeSource AncestorType=Window}}"
                              MaxDropDownHeight="350" Grid.ColumnSpan="2"
                              />

				</Grid>

				<Grid Grid.Column="2">

					<Button Margin="0,0,0,0"
                            HorizontalAlignment="Right" 
                            VerticalAlignment="Top" 
                            Width="33" 
                            Height="29"
                            Content="..."
                            Command="{Binding ShowUrisDialogCommand,RelativeSource={RelativeSource AncestorType=Window}}" 
                            />

				</Grid>

				<Grid Grid.Column="3">

					<StackPanel Margin="0,0,7,0">

						<StackPanel Visibility="{Binding StreamingStatus,Mode=OneWay,UpdateSourceTrigger=PropertyChanged,Converter={StaticResource RevertBooleanVisibilityValueConverter},RelativeSource={RelativeSource AncestorType=Window}}">
							<Button HorizontalAlignment="Right" 
									VerticalAlignment="Top" 
									Width="89" 
									Height="30"
									Content="Play" 
									Command="{Binding StartStreamingCommand,RelativeSource={RelativeSource AncestorType=Window}}" 
									/>
						</StackPanel>

						<StackPanel Visibility="{Binding StreamingStatus,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,Converter={StaticResource BooleanVisibilityValueConverter},RelativeSource={RelativeSource AncestorType=Window}}">
							<Button HorizontalAlignment="Right" 
									VerticalAlignment="Top" 
									Width="89" 
									Height="30"
									Content="Stop" 
									Command="{Binding StopStreamingCommand,RelativeSource={RelativeSource AncestorType=Window}}" 
									/>
						</StackPanel>

					</StackPanel>

				</Grid>

			</Grid>

			<Grid Grid.Row="1" Margin="1,0,1,1">

				<TabControl HorizontalAlignment="Stretch" 
							VerticalAlignment="Stretch" 
							TabStripPlacement="Bottom" 
							HorizontalContentAlignment="Center" 
							FontSize="20" 
							Padding="0,0,11,9"
							>

					<TabItem Header="VIDEO">

						<Grid Background="Black" Tag="{Binding RelativeSource={RelativeSource AncestorType=Window}}">

							<Grid.ContextMenu>

								<ContextMenu>

									<MenuItem Header="Stretch"
                                              IsCheckable="True"
                                              IsChecked="{Binding PlacementTarget.Tag.StretchImage,Mode=OneWay,UpdateSourceTrigger=PropertyChanged,Converter={StaticResource BooleanStretchValueConverter},RelativeSource={RelativeSource AncestorType=ContextMenu}}"
											  Command="{Binding PlacementTarget.Tag.ToggleStretchCommand,RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              />

									<Separator />

									<MenuItem Header="Show source info" 
                                              IsCheckable="True"
                                              IsChecked="{Binding PlacementTarget.Tag.InfoVisibility,Mode=OneWay,UpdateSourceTrigger=PropertyChanged,Converter={StaticResource VisibilityBooleanValueConverter},RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              Command="{Binding PlacementTarget.Tag.ShowInfoCommand,RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              />

									<MenuItem Header="Show statistics" 
                                              IsCheckable="True"
                                              IsChecked="{Binding PlacementTarget.Tag.StatisticsVisibility,Mode=OneWay,UpdateSourceTrigger=PropertyChanged,Converter={StaticResource VisibilityBooleanValueConverter},RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              Command="{Binding PlacementTarget.Tag.ShowStatisticsCommand,RelativeSource={RelativeSource AncestorType=ContextMenu}}"
											  />

									<Separator />

									<MenuItem Header="Save Image" 
                                              Command="{Binding PlacementTarget.Tag.SaveImageCommand,RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              />

								</ContextMenu>

							</Grid.ContextMenu>

							<controls:MediaPlayerControl x:Name="_mediaPlayer"
                                                         x:FieldModifier="private"
                                                         Focusable="True"
                                                         StretchImage="{Binding StretchImage,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,RelativeSource={RelativeSource AncestorType=Window}}"
                                                         SourceVisibility="{Binding InfoVisibility,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,RelativeSource={RelativeSource AncestorType=Window}}"
                                                         StatisticsVisibility="{Binding StatisticsVisibility,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,RelativeSource={RelativeSource AncestorType=Window}}"
														 SourceMargin="0,0,0,42" 
														 />

						</Grid>

					</TabItem>

					<TabItem Header="SCRIPT">
						<Grid>
							<TextBox Margin="10,10,10,50" 
									 HorizontalAlignment="Stretch" 
									 VerticalAlignment="Stretch" 
									 AcceptsReturn="True" 
									 AcceptsTab="True" 
									 Text="{Binding Script,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,RelativeSource={RelativeSource AncestorType=Window}}"
									 />

							<TextBlock Text="Not available" 
									   Foreground="Yellow" 
									   HorizontalAlignment="Center" 
									   VerticalAlignment="Center" 
									   />
						</Grid>
					</TabItem>

				</TabControl>

			</Grid>

		</Grid>

	</DockPanel>

</Window>
