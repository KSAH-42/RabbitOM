<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net10.0-windows</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<UseWPF>true</UseWPF>
		<RuntimeIdentifier>win-x64</RuntimeIdentifier>
		<SelfContained>true</SelfContained>
		<CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
		<AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<BaseOutputPath>bin\</BaseOutputPath>
		<OutputPath>bin\$(Configuration)\</OutputPath>
	</PropertyGroup>
	<PropertyGroup>
		<Product>RabbitOM</Product>
		<Authors>Rabbit Corp</Authors>
		<Description>Network communication library</Description>
		<Copyright>Copyright © 2026 RabbitOM</Copyright>
		<Trademark>RabbitOM™</Trademark>
		<MajorVersion>2</MajorVersion>
		<MinorVersion>0</MinorVersion>
		<PatchVersion>9</PatchVersion>
		<ApplicationIcon>Resources\icon.ico</ApplicationIcon>
	</PropertyGroup>
	<ItemGroup>
	  <Resource Include="Resources\icon.ico" />
	  <EmbeddedResource Include="Resources\ScriptTemplate.txt" />
	</ItemGroup>
	<ItemGroup>
		<ProjectReference Include="..\RabbitOM\RabbitOM.csproj" />
		<PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.8.0" />
		<PackageReference Include="Microsoft.CodeAnalysis.VisualBasic" Version="4.8.0" />
		<PackageReference Include="FFmpeg.AutoGen" Version="4.4.1.0" />
		<PackageReference Include="FFmpeg.Native" Version="4.4.0.2386" />
	</ItemGroup>
	<Target Name="AutoVersion" BeforeTargets="GenerateAssemblyInfo">
		<PropertyGroup>
			<Number>$([System.DateTime]::Now.ToString("yyyyMMdd"))</Number>
			<BuildNumber>$([System.String]::Copy($(Number)).Substring(0,3))</BuildNumber>
			<Version>$(MajorVersion).$(MinorVersion).$(PatchVersion).$(BuildNumber)</Version>
			<FileVersion>$(Version)</FileVersion>
			<InformationalVersion>$(Version)</InformationalVersion>
			<AssemblyVersion>$(Version)</AssemblyVersion>
		</PropertyGroup>
		<!--<Message Text="$(Version)" Importance="High" />-->
	</Target>
	<Target Name="CopyFFmpegNative" AfterTargets="Restore;Build">
		<PropertyGroup>
			<NuGetPackageRoot>$(SolutionDir)packages\</NuGetPackageRoot>
			<FFmpegPkg>
			</FFmpegPkg>
			<FFmpegFallback>$(NuGetPackageRoot)ffmpeg.native.*\</FFmpegFallback>
			<FFmpegRidPattern>win*-x64</FFmpegRidPattern>
		</PropertyGroup>
		<ItemGroup>
			<FFmpegNativeFiles Condition=" '$(FFmpegPkg)' != '' " Include="$(FFmpegPkg)\runtimes\$(FFmpegRidPattern)\native\*.dll" />
			<FFmpegNativeFiles Condition=" '$(FFmpegPkg)' == '' " Include="$(FFmpegFallback)**\runtimes\$(FFmpegRidPattern)\native\*.dll" />
		</ItemGroup>
		<Message Text="Copying PkgFFmpeg_Native_H265: @(PkgFFmpeg_Native_H265)" Importance="High" />
		<Message Text="Copying NuGetPackageRoot: @(NuGetPackageRoot)" Importance="High" />
		<Message Text="Copying FFmpegPkg: @(FFmpegPkg)" Importance="High" />
		<Message Text="Copying FFmpegFallback: @(FFmpegFallback)" Importance="High" />
		<Message Text="Copying FFmpeg native files: @(FFmpegNativeFiles)" Importance="High" />
		<Copy SourceFiles="@(FFmpegNativeFiles)" DestinationFiles="@(FFmpegDestinationFiles)" DestinationFolder="$(OutDir)" OverwriteReadOnlyFiles="true" SkipUnchangedFiles="false" Condition=" '@(FFmpegNativeFiles)' != '' " />
		<Message Text="FFmpeg output folder: $(OutDir)" Importance="High" />
	</Target>
</Project>