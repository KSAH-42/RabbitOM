<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    >
    <Style TargetType="{x:Type Button}">
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="SnapsToDevicePixels" Value="true" />
        <Setter Property="OverridesDefaultStyle" Value="true" />
        <Setter Property="KeyboardNavigation.TabNavigation" Value="Continue" />
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="FocusVisualStyle" >
            <Setter.Value>
                <Style TargetType="Control">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate>
                                <Border>
                                    <Rectangle Margin="2" 
                                               StrokeThickness="1" 
                                               Stroke="#60000000" 
                                               StrokeDashArray="1 2" 
                                               />
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect  BlurRadius="0" 
                                   ShadowDepth="0" 
                                   RenderingBias="Quality" 
                                   Color="White" 
                                   Opacity="0"
                                   />
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    
                    <ControlTemplate.Resources>
                        
                        <Storyboard x:Key="AnimationMouseOverOn">
                           
                            <ColorAnimationUsingKeyFrames Storyboard.TargetName="BorderGradientStop1" Storyboard.TargetProperty="Color" >
                                <SplineColorKeyFrame KeySpline="0.681,0.344,0.496,1" KeyTime="00:00:00.2300000" Value="#55868686"/>
                            </ColorAnimationUsingKeyFrames>

                            <ColorAnimationUsingKeyFrames Storyboard.TargetName="BorderGradientStop2" Storyboard.TargetProperty="Color" >
                                <SplineColorKeyFrame KeySpline="0.681,0.344,0.496,1" KeyTime="00:00:00.2300000" Value="#55272727"/>
                            </ColorAnimationUsingKeyFrames>

                            <ColorAnimationUsingKeyFrames Storyboard.TargetName="BorderGradientStop3" Storyboard.TargetProperty="Color">
                                <SplineColorKeyFrame KeySpline="0.681,0.344,0.496,1" KeyTime="00:00:00.2300000" Value="#558D8D8D"/>
                            </ColorAnimationUsingKeyFrames>
                            
                        </Storyboard>
                        
                        <Storyboard x:Key="AnimationMouseOverOff">
                            
                            <ColorAnimationUsingKeyFrames Storyboard.TargetName="BorderGradientStop1" Storyboard.TargetProperty="Color" >
                                <SplineColorKeyFrame KeySpline="0.681,0.344,0.496,1" KeyTime="00:00:00.2300000" Value="#55969696"/>
                            </ColorAnimationUsingKeyFrames>

                            <ColorAnimationUsingKeyFrames Storyboard.TargetName="BorderGradientStop2" Storyboard.TargetProperty="Color" >
                                <SplineColorKeyFrame KeySpline="0.681,0.344,0.496,1" KeyTime="00:00:00.2300000" Value="Black"/>
                            </ColorAnimationUsingKeyFrames>

                            <ColorAnimationUsingKeyFrames Storyboard.TargetName="BorderGradientStop3" Storyboard.TargetProperty="Color">
                                <SplineColorKeyFrame KeySpline="0.681,0.344,0.496,1" KeyTime="00:00:00.2300000" Value="#558D8D8D"/>
                            </ColorAnimationUsingKeyFrames>
                            
                        </Storyboard>
                        
                    </ControlTemplate.Resources>
                    
                    <Border x:Name="Root" 
                            CornerRadius="12" 
                            BorderThickness="0" 
                            BorderBrush="Black"
                            >
                        
                        <Border x:Name="Border" 
                                CornerRadius="12" 
                                Padding="0" 
                                BorderThickness="1.1" 
                                BorderBrush="White" 
                                Background="Transparent"
                                >
                        
                            <Grid>
                            
                                <ContentPresenter Name="PART_ContentPresenter" 
                                                  HorizontalAlignment="Center" 
                                                  VerticalAlignment="Center" 
                                                  RecognizesAccessKey="True"
                                                  >
                                    
                                    <ContentPresenter.Effect>
                                    
                                        <DropShadowEffect  BlurRadius="0" 
                                                           ShadowDepth="0"  
                                                           RenderingBias="Quality" 
                                                           Color="White" 
                                                           Opacity="0"
                                                           />
                                        
                                    </ContentPresenter.Effect>
                                    
                                </ContentPresenter>
                                
                            </Grid>
                            
                        </Border>
                        
                    </Border>
                    
                    <ControlTemplate.Triggers>

                        <Trigger Property="IsDefault" Value="true">
                            <Setter TargetName="Root"   Property="BorderThickness" Value="0" />
                            <Setter Property="Foreground" Value="White" />
                            <Setter TargetName="Border" Property="Background" Value="#E6225252" />
                        </Trigger>

                        <Trigger Property="IsMouseOver" Value="True">
                            
                            <Setter Property="Effect" TargetName="PART_ContentPresenter">
                                <Setter.Value>
                                    <DropShadowEffect  BlurRadius="0" ShadowDepth="0"  RenderingBias="Quality" Color="White" Opacity="0.3"/>
                                </Setter.Value>
                            </Setter>
                            <Setter Property="Effect" >
                                <Setter.Value>
                                    <DropShadowEffect  BlurRadius="0" ShadowDepth="0"  RenderingBias="Quality" Color="White" Opacity="0.7"/>
                                </Setter.Value>
                            </Setter>

                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="PART_ContentPresenter"  Storyboard.TargetProperty="Effect.BlurRadius" From="0" To="13" Duration="00:00:00.1300000" />
                                        <DoubleAnimation                                                Storyboard.TargetProperty="Effect.BlurRadius" From="0" To="13" Duration="00:00:00.1300000" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>

                        </Trigger>

                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="Border" Property="Background" Value="#E6625252">
                            </Setter>
                            <Setter Property="Effect" TargetName="PART_ContentPresenter">
                                <Setter.Value>
                                    <DropShadowEffect  BlurRadius="0" ShadowDepth="0"  RenderingBias="Quality" Color="White" Opacity="0.3"/>
                                </Setter.Value>
                            </Setter>
                            <Setter Property="Effect" >
                                <Setter.Value>
                                    <DropShadowEffect  BlurRadius="0" ShadowDepth="0"  RenderingBias="Quality" Color="White" Opacity="0.7"/>
                                </Setter.Value>
                            </Setter>

                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="PART_ContentPresenter"  Storyboard.TargetProperty="Effect.BlurRadius" From="0" To="13" Duration="00:00:00.1300000" />
                                        <DoubleAnimation                                                Storyboard.TargetProperty="Effect.BlurRadius" From="0" To="13" Duration="00:00:00.1300000" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                        </Trigger>

                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="PART_ContentPresenter" Property="Margin" Value="2,2,0,0"/>
                            <Setter TargetName="Border" Property="Background" Value="Transparent">
                            </Setter>
                            <Setter Property="RenderTransform" TargetName="Border">
                                <Setter.Value>
                                    <TransformGroup>
                                        <ScaleTransform ScaleX="0.99" ScaleY="0.99"/>
                                    </TransformGroup>
                                </Setter.Value>
                            </Setter>
                            <Setter Property="BorderThickness" TargetName="Border" Value="1.1"/>
                            <Setter Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect  BlurRadius="0" ShadowDepth="0"  RenderingBias="Quality" Color="White" Opacity="0"/>
                                </Setter.Value>
                            </Setter>
                            <Setter Property="Effect" TargetName="PART_ContentPresenter">
                                <Setter.Value>
                                    <DropShadowEffect  BlurRadius="0" ShadowDepth="0"  RenderingBias="Quality" Color="White" Opacity="0"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>

                        <Trigger Property="IsEnabled"   Value="False">
                            <Setter TargetName="Border" Property="BorderBrush"      Value="DarkGray"     />
                            <Setter TargetName="Border" Property="Background"       Value="Transparent"  />
                        </Trigger>

                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>