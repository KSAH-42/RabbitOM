<UserControl x:Class="RabbitOM.Player.Controls.ScriptEditorControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:RabbitOM.Player.Controls"
			 xmlns:converters="clr-namespace:RabbitOM.Player.Converters"
			 xmlns:avalonedit="http://icsharpcode.net/sharpdevelop/avalonedit"
             mc:Ignorable="d" 
             d:DesignHeight="450" 
			 d:DesignWidth="800"
			 >
	
	<UserControl.Resources>
		<converters:BooleanStringValueConverter x:Key="RunningStatusValueConverter" TrueString="Stop" FalseString="Run" />
	</UserControl.Resources>
	
	<Grid>

		<avalonedit:TextEditor 
				 Margin="0,1,0,50" 
				 HorizontalAlignment="Stretch" 
				 HorizontalScrollBarVisibility="Auto"
				 VerticalAlignment="Stretch" 
				 VerticalScrollBarVisibility="Auto"
				 BorderThickness="0.75"
				 FontFamily="Consolas"
				 FontSize="18"
				 Background="Black"
			     Foreground="White"
			     ShowLineNumbers="True"
				 local:TextEditorBehaviors.Text="{Binding Script,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
				 />

		<StackPanel HorizontalAlignment="Left" 
					VerticalAlignment="Bottom"
					Orientation="Horizontal"
					Margin="5,0,0,10"
					>

			<Button Content="Import"
					Width="100"
					Margin="0,0,0,0"
					Command="{Binding ImportCommand}"
					/>

			<Button Content="Export"
					HorizontalAlignment="Left" 
					VerticalAlignment="Bottom"
					Width="100"
					Margin="7,0,0,0"
					Command="{Binding ExportCommand}"
					/>
			
		</StackPanel>

		<StackPanel HorizontalAlignment="Right" 
					VerticalAlignment="Bottom"
					Orientation="Horizontal"
					Margin="0,0,5,10"
					>

			<Button Content="{Binding IsScriptRunning,Mode=OneWay,UpdateSourceTrigger=PropertyChanged,Converter={StaticResource RunningStatusValueConverter}}"
					Width="100"
					Margin="0,0,0,0"
					Command="{Binding StartStopCommand}"
					/>

		</StackPanel>

	</Grid>
	
</UserControl>
