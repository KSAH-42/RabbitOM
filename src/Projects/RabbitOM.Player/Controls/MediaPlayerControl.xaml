<UserControl x:Class="RabbitOM.Player.Controls.MediaPlayerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:RabbitOM.Player.Controls"
             xmlns:controls="clr-namespace:RabbitOM.Player.Controls"
             xmlns:converters="clr-namespace:RabbitOM.Player.Converters"
             mc:Ignorable="d" 
             d:DesignWidth="550"
             d:DesignHeight="450"
             >

    <UserControl.Resources>
        <ResourceDictionary>
            <converters:BooleanStretchValueConverter x:Key="BooleanStretchValueConverter" />
            <converters:BooleanVisibilityValueConverter x:Key="BooleanVisibilityValueConverter" />
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Grid.Row="1"
          Margin="1,1,1,1" 
          Background="Black"
		  >

		<controls:CommunicationStatusControl Fill="White"
											 VerticalAlignment="Center" 
                                             HorizontalAlignment="Center" 
                                             Foreground="White"
                                             ConnectingMessage="Connecting..."
                                             ConnectingStatus="{Binding IsConnecting,UpdateSourceTrigger=PropertyChanged,RelativeSource={RelativeSource AncestorType=UserControl}}"
                                             />

		<controls:ViewPortControl x:Name="_viewport"
               x:FieldModifier="private"
               Margin="0,0,0,0" 
               SnapsToDevicePixels="True" 
               UseLayoutRounding="True" 
			   HorizontalAlignment="Stretch"
               VerticalAlignment="Stretch"
			   StretchImage="{Binding StretchImage,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,RelativeSource={RelativeSource AncestorType=UserControl}}"
               />

        <controls:NetworkStatisticsControl x:Name="_statistics" 
                                           x:FieldModifier="private"
                                           Margin="10,20,0,0" 
                                           HorizontalAlignment="Left"
                                           VerticalAlignment="Top"
                                           Visibility="{Binding StatisticsVisibility,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,RelativeSource={RelativeSource AncestorType=UserControl}}"
                                           />

		<TextBlock FontSize="15" 
                   Foreground="White" 
                   Background="Black"
                   VerticalAlignment="Bottom"
                   HorizontalAlignment="Center"
				   Text="{Binding Source,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,RelativeSource={RelativeSource AncestorType=UserControl}}"
                   Visibility="{Binding SourceVisibility,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,RelativeSource={RelativeSource AncestorType=UserControl}}"
                   Margin="{Binding SourceMargin,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,RelativeSource={RelativeSource AncestorType=UserControl}}"
				   />

	</Grid>

</UserControl>
