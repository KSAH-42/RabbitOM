<Window x:Class="RabbitOM.Sample.Client.H265.Dialogs.SaveImageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RabbitOM.Sample.Client.H265.Dialogs"
        xmlns:system="clr-namespace:System;assembly=mscorlib"
        mc:Ignorable="d"
        Title="Saving picture" 
        Height="400" 
        Width="400"
        WindowStartupLocation="CenterOwner"
        >

    <Window.CommandBindings>

        <CommandBinding Command="{x:Static local:SaveImageDialog.SelectFileCommand}" 
                        CanExecute="OnCanSelectFile" 
                        Executed="OnSelectFile" 
                        />

        <CommandBinding Command="{x:Static local:SaveImageDialog.TakeSnapshotCommand}" 
                        CanExecute="OnCanTakeSnapshot" 
                        Executed="OnTakeSnapshot" 
                        />

        <CommandBinding Command="{x:Static local:SaveImageDialog.SaveButtonCommand}" 
                        CanExecute="OnCanSave" 
                        Executed="OnSave" 
                        />

    </Window.CommandBindings>

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="37" />
            <RowDefinition Height="*" />
            <RowDefinition Height="35" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,12,0,0" >

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="45"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">

                    <TextBlock Margin="10,0,0,0" Text="File :" />

                </Grid>

                <Grid Grid.Column="1">

                    <TextBox Margin="0,0,0,0" Text="{Binding FileName, Mode=TwoWay , UpdateSourceTrigger=PropertyChanged , RelativeSource={RelativeSource AncestorType=Window} }" />

                </Grid>

                <Grid Grid.Column="2">

                    <Button Margin="5,0,5,0"
                            Content="..."
                            VerticalAlignment="Bottom" 
                            HorizontalAlignment="Left"
                            Width="35"
                            Height="25"
                            Command="{x:Static local:SaveImageDialog.SelectFileCommand}"
                            />

                </Grid>

            </Grid>
        </Grid>

        <Grid Grid.Row="1" Background="Black" Margin="2,10,2,10">

            <Image Margin="0,0,0,0" 
                   Stretch="Uniform" 
                   SnapsToDevicePixels="True" 
                   UseLayoutRounding="True"
                   Source="{Binding Image,RelativeSource={RelativeSource AncestorType=Window}}"
                   />

        </Grid>

        <Grid Grid.Row="2">

            <Button Margin="5,0,5,10" 
                    Content="Snapshot"
                    VerticalAlignment="Bottom" 
                    HorizontalAlignment="Left"
                    Width="80"
                    Height="25"
                    Command="{x:Static local:SaveImageDialog.TakeSnapshotCommand}"
                    />

            <Button Margin="95,0,5,10" 
                    Content="Save"
                    VerticalAlignment="Bottom" 
                    HorizontalAlignment="Left"
                    Width="80"
                    Height="25"
                    Command="{x:Static local:SaveImageDialog.SaveButtonCommand}"
                    />

            <Button Margin="60,0,5,10" 
                    VerticalAlignment="Bottom" 
                    HorizontalAlignment="Right"
                    Width="80"
                    Height="25"
                    IsCancel="True" 
                    Content="Close"
                    />

        </Grid>

    </Grid>

</Window>
