<Window x:Class="RabbitOM.Sample.Client.H265.Dialogs.SaveImageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RabbitOM.Sample.Client.H265.Dialogs"
        xmlns:system="clr-namespace:System;assembly=mscorlib"
        mc:Ignorable="d"
        Title="Saving picture" 
        Height="400" 
        Width="400"
        WindowStartupLocation="CenterOwner"
        >

    <Window.CommandBindings>

        <CommandBinding Command="{x:Static local:SaveImageDialog.TakeSnapshotCommand}" 
                        CanExecute="OnCanTakeSnapshot" 
                        Executed="OnTakeSnapshot" 
                        />

        <CommandBinding Command="{x:Static local:SaveImageDialog.SaveButtonCommand}" 
                CanExecute="OnCanSave" 
                Executed="OnSave" 
                />

    </Window.CommandBindings>

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="35" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="Black" Margin="2,10,2,10">
       
            <Image Margin="0,0,0,0" 
                   Stretch="Uniform" 
                   SnapsToDevicePixels="True" 
                   UseLayoutRounding="True"
                   Source="{Binding Image,RelativeSource={RelativeSource AncestorType=Window}}"
                   />
            
        </Grid>
        
        <Grid Grid.Row="1">

            <Button Margin="8,0,95,10" 
                    VerticalAlignment="Bottom" 
                    HorizontalAlignment="Left"
                    Width="90"
                    Height="25"
                    IsCancel="True" 
                    Content="Take Snasphot"
                    Command="{x:Static local:SaveImageDialog.TakeSnapshotCommand}"
                    />

            <Button Margin="102,0,95,10" 
                    VerticalAlignment="Bottom" 
                    HorizontalAlignment="Left"
                    Width="80"
                    Height="25"
                    IsCancel="False"
                    IsDefault="True"
                    Content="Save"
                    Command="{x:Static local:SaveImageDialog.SaveButtonCommand}"
                    />

            <Button Margin="60,0,5,10" 
                    VerticalAlignment="Bottom" 
                    HorizontalAlignment="Right"
                    Width="80"
                    Height="25"
                    IsCancel="True" 
                    Content="Close"
                    />
            
        </Grid>
        
    </Grid>
    
</Window>
