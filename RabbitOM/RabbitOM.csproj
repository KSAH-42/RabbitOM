<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>disable</ImplicitUsings>
		<Nullable>disable</Nullable>
		<RuntimeIdentifier>win-x64</RuntimeIdentifier>
		<SelfContained>true</SelfContained>
		<CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
		<AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
	</PropertyGroup>
	<PropertyGroup>
		<Product>RabbitOM</Product>
		<Authors>Rabbit Corp</Authors>
		<Description>Network communication library</Description>
		<Copyright>Copyright © 2026 RabbitOM</Copyright>
		<Trademark>RabbitOM™</Trademark>
		<MajorVersion>2</MajorVersion>
		<MinorVersion>0</MinorVersion>
		<PatchVersion>9</PatchVersion>
	</PropertyGroup>
	<Target Name="AutoVersion" BeforeTargets="GenerateAssemblyInfo">
		<PropertyGroup>
			<Number>$([System.DateTime]::Now.ToString("yyyyMMdd"))</Number>
			<BuildNumber>$([System.String]::Copy($(Number)).Substring(0,3))</BuildNumber>
			<Version>$(MajorVersion).$(MinorVersion).$(PatchVersion).$(BuildNumber)</Version>
			<FileVersion>$(Version)</FileVersion>
			<InformationalVersion>$(Version)</InformationalVersion>
			<AssemblyVersion>$(Version)</AssemblyVersion>
		</PropertyGroup>		
		<!--<Message Text="$(Version)" Importance="High" />-->
	</Target>
</Project>
